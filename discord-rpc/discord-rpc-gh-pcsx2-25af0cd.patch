From 25af0cd7457c7fdcb7c6b5611c1088e9878f4c16 Mon Sep 17 00:00:00 2001
From: Bshar Esfky <bsharesfke05@gmail.com>
Date: Wed, 14 Oct 2026 15:03:46 +0300
Subject: [PATCH] 3rdparty/discord-rpc: Add status display type support

---
 3rdparty/discord-rpc/include/discord_rpc.h | 7 +++++++
 3rdparty/discord-rpc/src/serialization.cpp | 5 +++++
 2 files changed, 12 insertions(+)

diff --git a/3rdparty/discord-rpc/include/discord_rpc.h b/3rdparty/discord-rpc/include/discord_rpc.h
index 3e1441e05874f..78ab0573b0732 100644
--- a/3rdparty/discord-rpc/include/discord_rpc.h
+++ b/3rdparty/discord-rpc/include/discord_rpc.h
@@ -39,8 +39,15 @@ typedef struct DiscordRichPresence {
     const char* joinSecret;     /* max 128 bytes */
     const char* spectateSecret; /* max 128 bytes */
     int8_t instance;
+    int8_t status_display_type;
 } DiscordRichPresence;
 
+typedef enum DiscordStatusDisplayType {
+    DiscordStatusDisplayType_Name = 0,
+    DiscordStatusDisplayType_State = 1,
+    DiscordStatusDisplayType_Details = 2
+} DiscordStatusDisplayType;
+
 typedef struct DiscordUser {
     const char* userId;
     const char* username;
diff --git a/3rdparty/discord-rpc/src/serialization.cpp b/3rdparty/discord-rpc/src/serialization.cpp
index 6cc1e9013d8cf..c39578c30b627 100644
--- a/3rdparty/discord-rpc/src/serialization.cpp
+++ b/3rdparty/discord-rpc/src/serialization.cpp
@@ -155,6 +155,11 @@ size_t JsonWriteRichPresenceObj(char* dest,
 
                 writer.Key("instance");
                 writer.Bool(presence->instance != 0);
+
+                if (presence->status_display_type != DiscordStatusDisplayType_Name) {
+                    WriteKey(writer, "status_display_type");
+                    writer.Int(presence->status_display_type);
+                }
             }
         }
     }
