From: Phantom X <PhantomX@users.noreply.github.com>
Date: Sat, 3 Oct 2026 20:39:09 -0300
Subject: [PATCH] Use system libraries

---
 Makefile    | 11 +++++++++++
 chd.c       |  7 ++++++-
 chd.h       | 13 +++++++++++++
 event_log.c |  4 ++++
 event_log.h |  4 ++++
 png.c       |  4 ++++
 system.c    |  4 ++++
 zip.c       |  4 ++++
 8 files changed, 50 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 7e2a6ac..8f8bb1f 100644
--- a/Makefile
+++ b/Makefile
@@ -278,6 +278,9 @@ endif
 ifdef NOZLIB
 CFLAGS+= -DDISABLE_ZLIB
 LIBZOBJS=
+else ifdef HOST_ZLIB
+CFLAGS+= -DHOST_ZLIB
+RENDEROBJS+= png.o
 else
 RENDEROBJS+= $(LIBZOBJS) png.o
 endif
@@ -285,6 +288,10 @@ endif
 ifdef NOLZMA
 CFLAGS+= -DDISABLE_LZMA
 LZMAOBJS=
+else ifdef HOST_LZMA
+CFLAGS+= -DHOST_LZMA
+LIBS+= lzmasdk-c
+LZMAOBJS=
 else
 LZMAOBJS=lzma/LzmaDec.o lzma/LzmaEnc.o lzma/LzFind.o lzma/LzFindMt.o lzma/LzFindOpt.o lzma/CpuArch.o lzma/Threads.o
 ifeq ($(OS),Linux)
@@ -295,6 +302,10 @@ endif
 ifdef NOZSTD
 CFLAGS+= -DDISABLE_ZSTD
 ZSTDOBJS=
+else ifdef HOST_ZSTD
+CFLAGS+= -DHOST_ZSTD
+LIBS+= libzstd
+ZSTDOBJS=
 else
 CFLAGS+= -DZSTD_LEGACY_SUPPORT=0 -DZSTD_TRACE=0 -Izstd
 ZSTDOBJS=zstd/common/debug.o zstd/common/entropy_common.o zstd/common/error_private.o zstd/common/xxhash.o \
diff --git a/chd.c b/chd.c
index 178fa67..33bd2b6 100644
