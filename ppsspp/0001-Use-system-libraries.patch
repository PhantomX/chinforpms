diff --git a/ext/CMakeLists.txt b/ext/CMakeLists.txt
index a700a6b..88c2763 100644
--- a/ext/CMakeLists.txt
+++ b/ext/CMakeLists.txt
@@ -39,17 +39,42 @@ add_subdirectory(rcheevos-build)
 add_subdirectory(gason)
 add_subdirectory(vma)
 add_subdirectory(cityhash)
+find_package(PkgConfig QUIET)
+pkg_search_module(7zip IMPORTED_TARGET lzmasdk-c)
+if(7zip_FOUND)
+	message(STATUS "Using the system 7zip")
+	add_library(7zip INTERFACE)
+	include_directories(${7zip_INCLUDE_DIRS})
+	target_compile_definitions(7zip INTERFACE SHARED_7ZIP)
+	target_link_libraries(7zip INTERFACE PkgConfig::7zip)
+else()
 add_subdirectory(lzma-sdk)
+endif()
 add_subdirectory(basis_universal)
+
+find_package(pugixml GLOBAL)
+if(pugixml_FOUND)
+	message(STATUS "Using the system pugixml")
+	target_compile_definitions(pugixml::pugixml INTERFACE SYSTEM_PUGIXML)
+	add_library(pugixml ALIAS pugixml::pugixml)
+else()
 add_subdirectory(pugixml)
+endif()
 add_subdirectory(libkirk)
 add_subdirectory(sfmt19937)
 add_subdirectory(xbrz)
 
+pkg_search_module(xxhash IMPORTED_TARGET libxxhash)
+if(xxhash_FOUND)
+	message(STATUS "Using the system libxxhash")
+	add_library(xxhash INTERFACE)
+	target_link_libraries(xxhash INTERFACE PkgConfig::xxhash)
+else()
 add_library(xxhash STATIC
 	xxhash.c
 	xxhash.h
 )
+endif()
 
 set(FT_REQUIRE_ZLIB OFF CACHE BOOL "" FORCE)
 set(FT_REQUIRE_BZIP2 OFF CACHE BOOL "" FORCE)
