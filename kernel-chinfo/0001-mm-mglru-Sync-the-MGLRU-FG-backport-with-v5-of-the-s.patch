@@ -364,24 +373,25 @@ static inline unsigned long lru_gen_folio_seq(const struct lruvec *lruvec,
 	 * |<----------------------------------- MAX_NR_GENS ----------------------------------->|
 	 */
 	if (folio_test_active(folio))
-		gen = MIN_NR_GENS - (refs >= LRU_REFS_WORKINGSET);
