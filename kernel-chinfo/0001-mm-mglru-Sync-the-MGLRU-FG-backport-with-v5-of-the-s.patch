 	       gen == lru_gen_from_seq(min_seq + 1);
@@ -346,8 +355,8 @@ static inline unsigned long lru_gen_folio_seq(const struct lruvec *lruvec,
 					      const struct folio *folio,
 					      bool reclaiming)
 {
-	int gen;
