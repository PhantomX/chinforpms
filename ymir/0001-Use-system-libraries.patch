From: Phantom X <PhantomX@users.noreply.github.com>
Date: Sat, 24 May 2025 22:15:16 -0300
Subject: [PATCH] Use system libraries

---
 CMakeLists.txt                                |  2 ++
 apps/ymir-sdl3/CMakeLists.txt                 | 11 +++++--
 apps/ymir-sdl3/src/app/app.cpp                |  2 +-
 .../ymir-sdl3/src/app/services/midi_types.hpp |  2 +-
 .../ui/views/settings/audio_settings_view.cpp |  2 +-
 .../src/app/ui/windows/about_window.cpp       | 10 +-----
 vendor/CMakeLists.txt                         | 31 +++++++++++++++++--
 vendor/imgui/CMakeLists.txt                   |  2 ++
 8 files changed, 46 insertions(+), 16 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5cf130b..2dfaeb8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -151,6 +151,8 @@ else ()
     message(STATUS "IPO / LTO not supported: ${IPO_ERROR}")
 endif ()
 
+find_package(fmt CONFIG)
+
 ## Include third-party libraries
 add_subdirectory(vendor)
 
diff --git a/apps/ymir-sdl3/CMakeLists.txt b/apps/ymir-sdl3/CMakeLists.txt
index def8dbc..34e6a38 100644
--- a/apps/ymir-sdl3/CMakeLists.txt
+++ b/apps/ymir-sdl3/CMakeLists.txt
@@ -536,7 +536,14 @@ find_package(cxxopts CONFIG REQUIRED)
 find_package(date CONFIG REQUIRED)
 find_package(OpenSSL CONFIG REQUIRED)
 find_package(CURL REQUIRED)
-find_package(rtmidi CONFIG REQUIRED)
+find_package(rtmidi CONFIG)
+if(NOT rtmidi_FOUND)
+    set(RTMIDI_BUILD_STATIC_LIBS ON)
+    set(RTMIDI_BUILD_TESTING OFF)
+    add_subdirectory(rtmidi)
+    add_library(RtMidi::rtmidi ALIAS rtmidi)
+endif()
+find_package(SDL3 CONFIG REQUIRED)
 find_package(tomlplusplus CONFIG REQUIRED)
 
 target_include_directories(ymir-sdl3
@@ -559,7 +566,7 @@ target_link_libraries(ymir-sdl3 PRIVATE
     lz4::lz4
     discord-rpc
     RtMidi::rtmidi
-    CURL::libcurl_static
+    CURL::libcurl
     stb::stb
     dr_libs::dr_libs
 )
diff --git a/apps/ymir-sdl3/src/app/app.cpp b/apps/ymir-sdl3/src/app/app.cpp
index 45c2255..bac1182 100644
--- a/apps/ymir-sdl3/src/app/app.cpp
+++ b/apps/ymir-sdl3/src/app/app.cpp
@@ -126,7 +126,7 @@
 
 #include <stb_image.h>
 
-#include <rtmidi/RtMidi.h>
+#include <RtMidi.h>
 
 #include <clocale>
 #include <mutex>
diff --git a/apps/ymir-sdl3/src/app/services/midi_types.hpp b/apps/ymir-sdl3/src/app/services/midi_types.hpp
index 343fd17..c26253b 100644
--- a/apps/ymir-sdl3/src/app/services/midi_types.hpp
+++ b/apps/ymir-sdl3/src/app/services/midi_types.hpp
@@ -7,7 +7,7 @@
 //
 // Hopefully https://github.com/thestk/rtmidi/issues/367 is solved at some point.
 
-#include <rtmidi/RtMidi.h>
+#include <RtMidi.h>
 
 #include <memory>
 
diff --git a/apps/ymir-sdl3/src/app/ui/views/settings/audio_settings_view.cpp b/apps/ymir-sdl3/src/app/ui/views/settings/audio_settings_view.cpp
index b7abe98..02ea8c8 100644
--- a/apps/ymir-sdl3/src/app/ui/views/settings/audio_settings_view.cpp
+++ b/apps/ymir-sdl3/src/app/ui/views/settings/audio_settings_view.cpp
@@ -9,7 +9,7 @@
 
 #include <app/imgui_data.hpp>
 
-#include <rtmidi/RtMidi.h>
+#include <RtMidi.h>
 
 using namespace ymir;
 
diff --git a/apps/ymir-sdl3/src/app/ui/windows/about_window.cpp b/apps/ymir-sdl3/src/app/ui/windows/about_window.cpp
index 044a8fc..8feadba 100644
--- a/apps/ymir-sdl3/src/app/ui/windows/about_window.cpp
+++ b/apps/ymir-sdl3/src/app/ui/windows/about_window.cpp
@@ -32,15 +32,10 @@ CMRC_DECLARE(Ymir_sdl3_rc);
 #include <ngtcp2/version.h>
 #include <nlohmann/json.hpp>
 #include <openssl/opensslv.h>
-#include <rtmidi/RtMidi.h>
+#include <RtMidi.h>
 #include <semver.hpp>
 #include <toml++/toml.hpp>
 #include <xxhash.h>
-#include <zlib.h>
-#include <zstd.h>
-
-#define MINIZ_NO_ZLIB_COMPATIBLE_NAMES
-#include <miniz/miniz.h>
 
 #define _STR_IMPL(x) #x
 #define _STR(x) _STR_IMPL(x)
@@ -130,7 +125,6 @@ static const struct {
     {.name = "lz4",                           .version = LZ4_VERSION_STRING,         .license = licenseBSD2,          .repoURL = "https://github.com/lz4/lz4",                     .licenseURL = "https://github.com/lz4/lz4/blob/dev/lib/LICENSE",                        .homeURL = "https://lz4.org/",},
     {.name = "lzma",                          .version = LZMA_VERSION,               .license = licensePublicDomain,                                                                                                                                                       .homeURL = "https://www.7-zip.org/sdk.html",},
     {.name = "mio",                           .version = MIO_VERSION,                .license = licenseMIT,           .repoURL = "https://github.com/StrikerX3/mio",               .licenseURL = "https://github.com/StrikerX3/mio/blob/master/LICENSE"},
-    {.name = "miniz",                         .version = MZ_VERSION,                 .license = licenseMIT,           .repoURL = "https://github.com/richgel999/miniz",            .licenseURL = "https://github.com/richgel999/miniz/blob/master/LICENSE"},
     {.name = "moodycamel::\nConcurrentQueue", .version = "\n" MC_CONCQUEUE_VERSION,  .license = licenseBSD2,          .repoURL = "https://github.com/cameron314/concurrentqueue",  .licenseURL = "https://github.com/cameron314/concurrentqueue/blob/master/LICENSE.md"},
     {.name = "Neargye/semver",                .version = SEMVER_VERSION,             .license = licenseMIT,           .repoURL = "https://github.com/Neargye/semver",              .licenseURL = "https://github.com/Neargye/semver/blob/master/LICENSE"},
     {.name = "nghttp2",                       .version = NGHTTP2_VERSION,            .license = licenseMIT,           .repoURL = "https://github.com/nghttp2/nghttp2",             .licenseURL = "https://github.com/nghttp2/nghttp2/blob/master/COPYING",                 .homeURL = "https://nghttp2.org/"},
@@ -149,8 +143,6 @@ static const struct {
 #ifdef _WIN32
     {.name = "WIL",                                                                  .license = licenseMIT,           .repoURL = "https://github.com/Microsoft/wil",               .licenseURL = "https://github.com/microsoft/wil/blob/master/LICENSE"},
 #endif
-    {.name = "zlib",                          .version = ZLIB_VERSION,               .license = licenseZlib,          .repoURL = "https://github.com/madler/zlib",                 .licenseURL = "https://github.com/madler/zlib/blob/develop/LICENSE",                    .homeURL = "https://zlib.net/"},
-    {.name = "zstd",                          .version = ZSTD_VERSION_STRING,        .license = licenseBSD3,          .repoURL = "https://github.com/facebook/zstd",               .licenseURL = "https://github.com/facebook/zstd/blob/dev/LICENSE",                      .homeURL = "http://www.zstd.net/"},
 };
 
 
diff --git a/vendor/CMakeLists.txt b/vendor/CMakeLists.txt
index 1f64d96..c4d3f53 100644
--- a/vendor/CMakeLists.txt
+++ b/vendor/CMakeLists.txt
@@ -28,6 +28,8 @@ message(STATUS "Adding vendored libraries")
 ####################################################################################################
 # Dependencies used by ymir-core
 
+find_package(PkgConfig REQUIRED)
+
 # mio - https://github.com/vimpunk/mio
 # - Using StrikerX3's fork instead
 #   - This fork implements the features in this PR: https://github.com/vimpunk/mio/pull/78
@@ -37,8 +39,12 @@ add_subdirectory(mio EXCLUDE_FROM_ALL)
 
 # {fmt} - https://github.com/fmtlib/fmt
 message(STATUS "==> libfmt")
+if(fmt_FOUND)
+  message(STATUS "Using the system fmt")
+else()
 set(FMT_MODULE OFF)
 add_subdirectory(fmt)
+endif()
 
 # concurrentqueue - https://github.com/cameron314/concurrentqueue
 message(STATUS "==> concurrentqueue")
@@ -46,11 +52,26 @@ add_subdirectory(concurrentqueue EXCLUDE_FROM_ALL)
 
 # xxHash - https://github.com/Cyan4973/xxHash
 message(STATUS "==> xxHash")
+pkg_search_module(libxxhash IMPORTED_TARGET libxxhash)
+if(libxxhash_FOUND)
+  message(STATUS "Using the system libxxhash")
+  add_library(libxxhash INTERFACE)
+  target_link_libraries(libxxhash INTERFACE PkgConfig::libxxhash)
+  add_library(xxHash::xxHash ALIAS libxxhash)
+else()
 add_subdirectory(xxHash EXCLUDE_FROM_ALL)
+endif()
 
 # libchdr - https://github.com/rtissera/libchdr
 message(STATUS "==> libchdr")
+pkg_search_module(libchdr IMPORTED_TARGET libchdr)
+if(libchdr_FOUND)
+  message(STATUS "Using the system libchdr")
+  add_library(chdr-static INTERFACE)
+  target_link_libraries(chdr-static INTERFACE PkgConfig::libchdr)
+else()
 add_subdirectory(libchdr)
+endif()
 
 # stb - https://github.com/nothings/stb
 message(STATUS "==> stb")
@@ -77,8 +98,6 @@ if (NOT Ymir_LIBRARY_ONLY)
     # SDL3 - https://github.com/libsdl-org/SDL
     # - Unable to configure libdecor support for Wayland
     # - Must be added BEFORE dear ImGui
-    message(STATUS "==> SDL3")
-    add_subdirectory(SDL3 EXCLUDE_FROM_ALL)
 
     # dear ImGui - https://github.com/ocornut/imgui
     # - Using the docking branch
@@ -88,7 +107,15 @@ if (NOT Ymir_LIBRARY_ONLY)
     # lz4 - https://github.com/lz4/lz4
     # - Unable to configure AVX2 support from vcpkg
     message(STATUS "==> lz4")
+    pkg_search_module(liblz4 IMPORTED_TARGET liblz4)
+    if(liblz4_FOUND)
+      message(STATUS "Using the system liblz4")
+      add_library(liblz4 INTERFACE)
+      target_link_libraries(liblz4 INTERFACE PkgConfig::liblz4)
+      add_library(lz4::lz4 ALIAS liblz4)
+    else()
     add_subdirectory(lz4 EXCLUDE_FROM_ALL)
+    endif()
 
     # discord-rpc - https://github.com/discord/discord-rpc
     # - Via myMCpp / PCSX2
diff --git a/vendor/imgui/CMakeLists.txt b/vendor/imgui/CMakeLists.txt
index ba8b35d..e460186 100644
--- a/vendor/imgui/CMakeLists.txt
+++ b/vendor/imgui/CMakeLists.txt
@@ -78,6 +78,8 @@ target_include_directories(imgui
 target_compile_features(imgui PUBLIC cxx_std_20)
 target_compile_definitions(imgui PUBLIC IMGUI_USER_CONFIG="ymir_imconfig.h")
 
+find_package(SDL3 CONFIG REQUIRED)
+
 target_link_libraries(imgui PRIVATE SDL3::SDL3)
 if (Vulkan_FOUND)
 	target_link_libraries(imgui PRIVATE Vulkan::Vulkan)
-- 
