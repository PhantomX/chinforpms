Subject: [PATCH] Use system libraries

---
 CMakeLists.txt                                |  2 ++
 apps/ymir-sdl3/CMakeLists.txt                 | 10 +++++--
 apps/ymir-sdl3/src/app/app.cpp                |  2 +-
 .../ymir-sdl3/src/app/services/midi_types.hpp |  2 +-
 .../ui/views/settings/audio_settings_view.cpp |  2 +-
 .../src/app/ui/windows/about_window.cpp       | 11 +------
 vendor/CMakeLists.txt                         | 29 +++++++++++++++++++
 7 files changed, 43 insertions(+), 15 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f8dba8a..deaab1c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -146,6 +146,8 @@ else ()
     message(STATUS "IPO / LTO not supported: ${IPO_ERROR}")
 endif ()
 
+find_package(fmt CONFIG)
+
 ## Include third-party libraries
 add_subdirectory(vendor)
 
diff --git a/apps/ymir-sdl3/CMakeLists.txt b/apps/ymir-sdl3/CMakeLists.txt
index 06609a7..e5d6b66 100644
--- a/apps/ymir-sdl3/CMakeLists.txt
+++ b/apps/ymir-sdl3/CMakeLists.txt
@@ -530,7 +530,13 @@ find_package(cxxopts CONFIG REQUIRED)
 find_package(date CONFIG REQUIRED)
 find_package(OpenSSL CONFIG REQUIRED)
 find_package(CURL REQUIRED)
-find_package(rtmidi CONFIG REQUIRED)
+find_package(rtmidi CONFIG)
+if(NOT rtmidi_FOUND)
+    set(RTMIDI_BUILD_STATIC_LIBS ON)
+    set(RTMIDI_BUILD_TESTING OFF)
+    add_subdirectory(rtmidi)
+    add_library(RtMidi::rtmidi ALIAS rtmidi)
+endif()
 find_package(SDL3 CONFIG REQUIRED)
 find_package(tomlplusplus CONFIG REQUIRED)
 
@@ -554,7 +560,7 @@ target_link_libraries(ymir-sdl3 PRIVATE
     lz4::lz4
     discord-rpc
     RtMidi::rtmidi
-    CURL::libcurl_static
+    CURL::libcurl
     stb::stb
     dr_libs::dr_libs
 )
diff --git a/apps/ymir-sdl3/src/app/app.cpp b/apps/ymir-sdl3/src/app/app.cpp
index 38e290c..abca943 100644
